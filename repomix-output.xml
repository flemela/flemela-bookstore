<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue';
import { ChevronLeft, ChevronRight, ArrowRight, Sparkles } from 'lucide-vue-next';
import HeroReference from '~/components/storefront/HeroReference.vue';

interface PublicBanner {
  id: string;
  title: string;
  subtitle: string | null;
  badge: string | null;
  image_url: string;
  mobile_image_url: string | null;
  cta_label: string;
  cta_link: string;
  bg_color: string;
  sort_order: number;
}

const emit = defineEmits<{
  search: [query: string, category: string];
  selectCategory: [category: string];
}>();

const { data: banners } = await useFetch<PublicBanner[]>('/api/banners');

const activeIndex = ref(0);
const isPaused = ref(false);
let autoplayTimer: ReturnType<typeof setInterval> | undefined;

// Touch Swipe State
const touchStartX = ref(0);
const touchEndX = ref(0);

const hasBanners = computed(() => {
  return banners.value && banners.value.length > 0;
});

const slideCount = computed(() => {
  return banners.value ? banners.value.length : 0;
});

function nextSlide(): void {
  if (slideCount.value <= 1) return;
  activeIndex.value = (activeIndex.value + 1) % slideCount.value;
  resetAutoplay();
}

function prevSlide(): void {
  if (slideCount.value <= 1) return;
  activeIndex.value = (activeIndex.value - 1 + slideCount.value) % slideCount.value;
  resetAutoplay();
}

function goToSlide(index: number): void {
  activeIndex.value = index;
  resetAutoplay();
}

function startAutoplay(): void {
  stopAutoplay();
  if (slideCount.value > 1 && !isPaused.value) {
    autoplayTimer = setInterval(() => {
      nextSlide();
    }, 5500);
  }
}

function stopAutoplay(): void {
  if (autoplayTimer) {
    clearInterval(autoplayTimer);
    autoplayTimer = undefined;
  }
}

function resetAutoplay(): void {
  startAutoplay();
}

function handleMouseEnter(): void {
  isPaused.value = true;
  stopAutoplay();
}

function handleMouseLeave(): void {
  isPaused.value = false;
  startAutoplay();
}

// Touch Gestures
function handleTouchStart(e: TouchEvent): void {
  touchStartX.value = e.touches[0].clientX;
  isPaused.value = true;
  stopAutoplay();
}

function handleTouchEnd(e: TouchEvent): void {
  touchEndX.value = e.changedTouches[0].clientX;
  const deltaX = touchStartX.value - touchEndX.value;

  if (Math.abs(deltaX) > 40) {
    if (deltaX > 0) {
      nextSlide();
    } else {
      prevSlide();
    }
  }

  isPaused.value = false;
  startAutoplay();
}

async function handleBannerClick(banner: PublicBanner): Promise<void> {
  try {
    // Non-blocking click analytics ping
    await $fetch(`/api/v1/banners/${banner.id}/click`, { method: 'POST' }).catch(() => {});
  } catch {
    // Silent
  }

  if (banner.cta_link.startsWith('http')) {
    window.open(banner.cta_link, '_blank', 'noopener,noreferrer');
  } else if (banner.cta_link.startsWith('#')) {
    const el = document.querySelector(banner.cta_link);
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  } else {
    navigateTo(banner.cta_link);
  }
}

onMounted(() => {
  // Respect user preference for reduced motion (WCAG 2.2.2)
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    return;
  }
  startAutoplay();
});

onUnmounted(() => {
  stopAutoplay();
});
</script>

<template>
  <!-- If zero banners exist, seamlessly fall back to default editorial poster hero -->
  <HeroReference
    v-if="!hasBanners"
    @search="(q, cat) => emit('search', q, cat)"
    @select-category="(cat) => emit('selectCategory', cat)"
  />

  <!-- Infinitely Looping Promotional Hero Carousel -->
  <section
    v-else
    class="relative select-none overflow-hidden bg-[#052219] text-white"
    @mouseenter="handleMouseEnter"
    @mouseleave="handleMouseLeave"
    @touchstart="handleTouchStart"
    @touchend="handleTouchEnd"
  >
    <!-- Slide Container with aspect ratio locking preventing CLS layout shifts -->
    <div class="relative w-full aspect-[21/9] sm:aspect-[24/9] min-h-[380px] sm:min-h-[460px] lg:min-h-[500px]">
      <div
        v-for="(banner, index) in banners"
        :key="banner.id"
        class="absolute inset-0 transition-opacity duration-700 ease-in-out"
        :class="index === activeIndex ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'"
        :style="{ backgroundColor: banner.bg_color || '#052219' }"
      >
        <!-- Background Banner Image with Core Web Vitals LCP Optimization -->
        <picture>
          <source v-if="banner.mobile_image_url" :srcset="banner.mobile_image_url" media="(max-width: 640px)" />
          <img
            :src="banner.image_url"
            :alt="banner.title"
            class="w-full h-full object-cover object-center brightness-75 scale-100 transition-transform duration-1000 ease-out"
            :class="{ 'scale-105': index === activeIndex }"
            :loading="index === 0 ? 'eager' : 'lazy'"
            :fetchpriority="index === 0 ? 'high' : 'auto'"
          />
        </picture>

        <!-- Slide Overlay Content -->
        <div class="absolute inset-0 z-10 flex items-center bg-gradient-to-r from-forest-950/90 via-forest-950/50 to-transparent">
          <div class="max-w-6xl mx-auto w-full px-6 sm:px-12 lg:px-16 space-y-4 text-left">
            
            <!-- Badge -->
            <div v-if="banner.badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-forest-950/80 border border-gold-500/60 text-xs font-mono font-bold text-gold-300 shadow-sm">
              <Sparkles :size="12" class="text-gold-400" />
              <span>{{ banner.badge }}</span>
            </div>

            <!-- Title -->
            <h2 class="font-display text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight max-w-2xl drop-shadow-md">
              {{ banner.title }}
            </h2>

            <!-- Subtitle -->
            <p v-if="banner.subtitle" class="text-xs sm:text-sm lg:text-base text-white/80 max-w-lg leading-relaxed line-clamp-2">
              {{ banner.subtitle }}
            </p>

            <!-- CTA Button -->
            <div class="pt-2">
              <button
                type="button"
                class="bg-theme-coral hover:bg-theme-coral-hover text-white text-xs sm:text-sm font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all flex items-center gap-2 shadow-lg cursor-pointer active:scale-95"
                @click="handleBannerClick(banner)"
              >
                <span>{{ banner.cta_label }}</span>
                <ArrowRight :size="15" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Arrows (Only rendered if > 1 slide) -->
    <div v-if="slideCount > 1" class="absolute inset-y-0 inset-x-4 z-20 flex items-center justify-between pointer-events-none">
      <button
        type="button"
        class="w-10 h-10 rounded-full bg-forest-950/60 hover:bg-forest-950 text-white flex items-center justify-center pointer-events-auto backdrop-blur-xs transition-all shadow-md active:scale-95 cursor-pointer"
        aria-label="Previous promotional slide"
        @click="prevSlide"
      >
        <ChevronLeft :size="18" />
      </button>

      <button
        type="button"
        class="w-10 h-10 rounded-full bg-forest-950/60 hover:bg-forest-950 text-white flex items-center justify-center pointer-events-auto backdrop-blur-xs transition-all shadow-md active:scale-95 cursor-pointer"
        aria-label="Next promotional slide"
        @click="nextSlide"
      >
        <ChevronRight :size="18" />
      </button>
    </div>

    <!-- Indicator Dots (Only rendered if > 1 slide) -->
    <div v-if="slideCount > 1" class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
      <button
        v-for="(_, idx) in banners"
        :key="idx"
        type="button"
        class="h-2 rounded-full transition-all duration-300 cursor-pointer"
        :class="idx === activeIndex ? 'w-6 bg-gold-500' : 'w-2 bg-white/40 hover:bg-white/70'"
        :aria-label="`Navigate to slide ${idx + 1}`"
        @click="goToSlide(idx)"
      />
    </div>
  </section>
</template>
