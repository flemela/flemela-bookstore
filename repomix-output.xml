          <!-- Celebration Header -->
          <div class="text-center space-y-2 pb-6 border-b border-paper-border">
            <div class="w-14 h-14 bg-emerald-100 text-forest-950 rounded-full flex items-center justify-center mx-auto shadow-sm">
