                @click="handleManualCheckStatus"
              >
                <RefreshCw :size="12" :class="{ 'animate-spin': isManualChecking }" />
                <span>Check Status</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 2. Automated STK Pending Prompt -->
