            </span>
          </div>

          <!-- STEP 1: Contact Information -->
          <div class="bg-white rounded-xl shadow-subtle border border-ink-border p-6 space-y-4">
            <div class="flex items-center gap-2.5 pb-3 border-b border-ink-border">
              <span class="w-6 h-6 rounded-full bg-forest-900 text-white text-xs font-mono font-bold flex items-center justify-center">1</span>
              <h2 class="font-display text-base font-bold text-forest-950">Contact Details</h2>
            </div>

            <div class="space-y-3">
              <div class="space-y-1">
                <label class="text-xs font-semibold text-forest-950">Full Name *</label>
                <div class="relative flex items-center">
                  <User :size="16" class="absolute left-3 text-ink-muted pointer-events-none" />
                  <input
                    v-model="customerName"
                    type="text"
                    placeholder="e.g. Joy Wanjiku"
                    class="w-full pl-9 pr-3 py-2 border border-ink-border rounded text-sm outline-none focus:border-forest-900"
                    required
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label class="text-xs font-semibold text-forest-950">M-Pesa Phone Number *</label>
                  <div class="relative flex items-center">
                    <Phone :size="16" class="absolute left-3 text-ink-muted pointer-events-none" />
                    <input
                      v-model="customerPhone"
                      type="tel"
                      placeholder="07XXXXXXXX or 01XXXXXXXX"
                      class="w-full pl-9 pr-20 py-2 border border-ink-border rounded text-sm outline-none focus:border-forest-900 font-mono"
                      required
                    />
                    <span
                      v-if="detectedCarrier"
                      class="absolute right-2 text-[9px] font-mono font-extrabold uppercase px-1.5 py-0.5 rounded tracking-wide"
                      :class="{
                        'bg-emerald-100 text-emerald-950': detectedCarrier === 'safaricom',
                        'bg-red-100 text-red-950': detectedCarrier === 'airtel',
                        'bg-amber-100 text-amber-950': detectedCarrier === 'telkom',
                      }"
                    >
                      {{ detectedCarrier }}
                    </span>
                  </div>
                </div>

                <div class="space-y-1">
                  <label class="text-xs font-semibold text-forest-950">Email (For receipt &amp; eBook backup)</label>
                  <div class="relative flex items-center">
                    <Mail :size="16" class="absolute left-3 text-ink-muted pointer-events-none" />
                    <input
                      v-model="customerEmail"
