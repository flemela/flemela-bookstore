const coverPublicId = ref('');
const isUploadingCover = ref(false);
const isSearchingCover = ref(false);

// New Format State
const newFormatType = ref<BookFormatType>('pdf');
const newFormatPrice = ref(149);
const newFormatStock = ref<number | null>(null);
