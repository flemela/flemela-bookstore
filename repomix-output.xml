            <div class="flex items-center gap-2.5 pb-3 border-b border-ink-border">
              <span class="w-6 h-6 rounded-full bg-forest-900 text-white text-xs font-mono font-bold flex items-center justify-center">
                {{ hasPhysicalItems ? '3' : '2' }}
