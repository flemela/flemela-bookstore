                      class="w-full pl-9 pr-3 py-2 border border-ink-border rounded text-sm outline-none focus:border-forest-900"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 2: Physical Delivery & GPS Pin Picker -->
          <div v-if="hasPhysicalItems" class="bg-white rounded-xl shadow-subtle border border-ink-border p-6 space-y-4">
            <div class="flex items-center gap-2.5 pb-3 border-b border-ink-border">
              <span class="w-6 h-6 rounded-full bg-forest-900 text-white text-xs font-mono font-bold flex items-center justify-center">2</span>
              <h2 class="font-display text-base font-bold text-forest-950">Fulfillment &amp; Delivery Option</h2>
            </div>

            <DeliveryTypeStep v-model="deliveryType" />

            <div v-if="deliveryType === 'delivery'" class="space-y-4 pt-2">
              <div class="space-y-1">
                <label class="text-xs font-semibold text-forest-950">Estate / Area Name *</label>
                <div class="relative flex items-center">
                  <MapPin :size="16" class="absolute left-3 text-ink-muted pointer-events-none" />
                  <input
                    v-model="estate"
