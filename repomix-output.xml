// =============================================================================
// middleware/admin-auth.ts
// Nuxt page route middleware guarding /admin/* views.
// =============================================================================

export default defineNuxtRouteMiddleware((to) => {
  const publicAuthRoutes = ['/admin/login', '/admin/register'];
  const sessionCookie = useCookie<string | null>('flemela_admin_session');

  // If visiting login or register while already authenticated, forward to admin
  if (publicAuthRoutes.includes(to.path)) {
    if (sessionCookie.value) {
      return navigateTo('/admin', { replace: true });
    }
    return;
  }

  // If accessing protected /admin/* routes without a session, redirect to login
  if (!sessionCookie.value) {
    return navigateTo({
      path: '/admin/login',
      query: { redirect: to.fullPath },
    }, { replace: true });
  }
});
